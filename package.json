{
  "name": "later",
  "private": true,
  "workspaces": [
    "packages/web"
  ],
  "scripts": {
    "dev:all": "concurrently \"bun run dev:api\" \"bun run dev:web\"",
    "dev:api": "cd packages/api && cargo run",
    "dev:web": "cd packages/web && bun run dev",
    "fmt": "prettier --write .",
    "test:all": "bun run test --workspaces && cargo test --workspace"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "concurrently": "^8.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "typescript": "^5.0.0"
  }
}
